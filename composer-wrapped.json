{
  "name": "rotdrop/cafevdb-nextcloud",
  "description": "Orchestra Management App",
  "type": "project",
  "license": "AGPL",
  "authors": [
    {
      "name": "Claus-Justus Heine"
    }
  ],
  "config": {
    "vendor-dir": "vendor-wrapped",
    "allow-plugins": {
      "cweagans/composer-patches": true
    }
  },
  "require": {
    "beberlei/doctrineextensions": "^1.2.0",
    "bytestream/horde-imap-client": "*",
    "cjh/doctrine-on-update-extension": "dev-master",
    "firehed/dbal-logger": "^2.0.0",
    "doctrine/annotations": "*",
    "doctrine/dbal": "^4.0",
    "doctrine/orm": "dev-production/3.6.x/cafevdb",
    "gedmo/doctrine-extensions": "3.x-dev",
    "maennchen/zipstream-php": "^3.0.0",
    "mediamonks/doctrine-extensions": "0.1.x-dev",
    "nesbot/carbon": "^2.46",
    "ramsey/uuid": "^4",
    "ramsey/uuid-doctrine": "^2.0",
    "symfony/cache": "^6",
    "symfony/string": "*"
  },
  "repositories": [
    {
      "type": "path",
      "url": "3rdparty/doctrine-orm",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "3rdparty/mediamonks-doctrine-extensions",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "3rdparty/doctrine-on-update-extension",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "3rdparty/gedmo-doctrine-extensions",
      "options": {
        "symlink": false
      }
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "cweagans/composer-patches": "^1.7"
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\CAFEVDB\\DevScripts\\PhpToTypeScript\\": "dev-scripts/php-to-typescript",
      "Spatie\\TypeScriptTransformer\\": "vendor-bin/typescript-transformer/vendor/spatie/typescript-transformer/src/"
    }
  },
  "extra": {
    "patches": {
      "bytestream/horde-socket-client": {
        "Add an optional progress callback to the Horde Socket Client": "../composer-patches/bytestream/horde-socket-client/progress-callback.patch"
      },
      "bytestream/horde-imap-client": {
        "Add an optional progress callback to the Horde IMAP Client": "../composer-patches/bytestream/horde-imap-client/write-progress-callback.patch"
      },
      "doctrine/dbal": {
        "Fix Index::spansColumns() to also check the number of columns": "../composer-patches/doctrine/dbal/fix-index-spans-columns.patch",
        "Fix MariaDB default values for date(time) stuff": "../composer-patches/doctrine/dbal/fix-mariadb-datetime-defaults.patch"
      },
      "symfony/string": {
        "Add AsciiSlugger::transliterate($string, $locale), transliterate only": "../composer-patches/symfony/string/enhance-ascii-slugger.patch"
      }
    }
  }
}
