{
  "name": "rotdrop/cafevdb-nextcloud",
  "description": "Orchestra Management App",
  "type": "project",
  "license": "AGPL",
  "authors": [
    {
      "name": "Claus-Justus Heine"
    }
  ],
  "config": {
    "vendor-dir": "vendor-wrapped",
    "allow-plugins": {
      "cweagans/composer-patches": true
    }
  },
  "require": {
    "beberlei/doctrineextensions": "^1.2.0",
    "bytestream/horde-imap-client": "*",
    "cjh/doctrine-on-update-extension": "dev-master",
    "firehed/dbal-logger": "^2.0.0",
    "doctrine/annotations": "*",
    "doctrine/dbal": "^4.0",
    "doctrine/migrations": "*",
    "doctrine/orm": "dev-production/3.7.x/cafevdb",
    "gedmo/doctrine-extensions": "3.7.x-dev",
    "maennchen/zipstream-php": "^3.0.0",
    "mediamonks/doctrine-extensions": "0.1.x-dev",
    "nesbot/carbon": "^2.46",
    "ramsey/uuid": "^4",
    "ramsey/uuid-doctrine": "^2.0",
    "rotdrop/nextcloud-app-toolkit": "dev-main",
    "symfony/cache": "^6",
    "symfony/string": "*"
  },
  "provide": {
    "phpunit/phpunit": "*",
    "psr/clock": "*",
    "psr/log": "^3.0.0",
    "symfony/console": "^6.0.0",
    "symfony/polyfill-php86": "*"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/rotdrop/nextcloud-app-toolkit"
    },
    {
      "type": "path",
      "url": "3rdparty/doctrine-orm",
      "options": {
        "versions": {
          "doctrine/orm": "dev-production/3.7.x/cafevdb"
        },
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "3rdparty/mediamonks-doctrine-extensions",
      "options": {
        "versions": {
          "mediamonks/doctrine-extensions": "0.1.x-dev"
        },
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "3rdparty/doctrine-on-update-extension",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "3rdparty/gedmo-doctrine-extensions",
      "options": {
        "versions": {
          "gedmo/doctrine-extensions": "3.7.x-dev"
        },
        "symlink": false
      }
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "cweagans/composer-patches": "^1.7",
    "doctrine/sql-formatter": "*"
  },
  "extra": {
    "patches": {
      "bytestream/horde-socket-client": {
        "Add an optional progress callback to the Horde Socket Client": "../dev-scripts/lib/patches/bytestream/horde-socket-client/progress-callback.patch"
      },
      "bytestream/horde-imap-client": {
        "Add an optional progress callback to the Horde IMAP Client": "../dev-scripts/lib/patches/bytestream/horde-imap-client/write-progress-callback.patch"
      },
      "doctrine/dbal": {
        "Fix Index::spansColumns() to also check the number of columns": "../dev-scripts/lib/patches/doctrine/dbal/fix-index-spans-columns.patch"
      },
      "doctrine/migrations": {
        "Make the DependencyFactory extendable": "../dev-scripts/lib/patches/doctrine/migrations/extendable-dependency-factory.patch",
        "Handle micro-second resolution in executedAt": "../dev-scripts/lib/patches/doctrine/migrations/handle-micro-second-resolution.patch"
      },
      "nesbot/carbon": {
        "Fix setAccessible() deprecation": "../dev-scripts/lib/patches/nesbot/carbon/fix-set-accessible-deprecation.php"
      },
      "symfony/string": {
        "Add AsciiSlugger::transliterate($string, $locale), transliterate only": "../dev-scripts/lib/patches/symfony/string/enhance-ascii-slugger.patch"
      }
    }
  }
}
