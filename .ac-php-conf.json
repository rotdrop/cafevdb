{
  "use-cscope": null,
  "tag-dir": null,
  "filter": {
    "php-file-ext-list": [
      "php"
    ],
    "php-path-list": [
      ".",
      "../../3rdparty",
      "../../lib",
      "../bav/lib",
      "../cafevdbmembers/lib",
      "../dav/lib",
      "../dokuwiki/lib",
      "../files/lib",
      "../files_trashbin/lib",
      "../mail/lib",
      "../mail_roundcube/lib",
      "../redaxo/lib",
      "../text/lib",
      "../user_sql/lib"
    ],
    "php-path-list-without-subdir": [],
    "ignore-ruleset": [
      "# like .gitignore file ",
      "/3rdparty/**/[Ee]xamples/**/*.php",
      "/3rdparty/**/[tT]ests/**/*.php",
      "/build/**",
      "/dev-scripts/playground/**",
      "/vendor-bin/cs-fixer/**",
      "/vendor-bin/php-scoper/**",
      "/vendor-bin/rector/**",
      "/vendor*/**/polyfill-php80/**/*.php",
      "/vendor*/**/polyfill-php81/**/*.php",
      "/vendor*/humbug/php-scoper/**",
      "/vendor*/jpgraph/**",
      "/vendor/**/[Ee]xamples/**/*.php",
      "/vendor/**/[tT]ests/**/*.php",
      "/vendor/*.php",
      "/vendor/composer/*.php",
      "/vendor/squizlabs/php_codesniffer/**/*.php",
      "#  -- end -- "
    ]
  }
}
