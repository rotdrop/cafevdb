{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "./src/toolkit/types/custom.d.ts",
    "./build/ts-types/**.ts",
    "./node_modules/is-plain-object/**.ts",
    "./node_modules/@nextcloud/**.ts",
    "./node_modules/@rotdrop/**.ts",
    "./node_modules/@types/**.d.ts",
    "./node_modules/@files/**.ts",
    "./node_modules/@dialogs/**.ts",
    "./node_modules/@iframe-resizer/**.ts",
    "./node_modules/axios/**.ts",
    "./node_modules/camelcase/**.ts",
    "./node_modules/ckeditor5/**.ts",
    "./node_modules/moment/**.ts",
    "./node_modules/vue-router/**/*.ts",
    "./node_modules/pinia/**.ts",
    "./node_modules/vue/**/*.ts",
    "./node_modules/vue-router/**/*.ts",
    "./node_modules/vite/**/*.ts",
    "./node_modules/vitest/**/*.ts",
    "./tests/vitest/**/*.ts",
    "./src/**/*.ts",
    "./src/**/*.vue",
    "./src/*-shim.d.ts",
    "./src/*.ts",
    "./build/ts-types/app-config.ts",
    "./build/ts-types/php-modules/**.ts",
    "./src/*.vue"
  ],
  "exclude": [
    "./node_modules/**/*.spec*",
    "./node_modules/**/e2e/**/*",
    "./node_modules/**/*test*/**/*",
    "./node_modules/**/src/**/*"
  ],
  "compilerOptions": {
    "types": [
      "bootstrap",
      "camelcase",
      "chosen-js",
      "jquery",
      "jqueryui",
      "moment",
      "node",
      "popper.js",
      "vitest/jsdom"
    ],
    "paths": {
      "~/*": ["./*"]
    },
    "traceResolution": false,
    "lib": [ "ESNext", "DOM", "DOM.Iterable" ],
    "rootDir": "./",
    "outDir": "./dist/",
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false
  },
  "vueCompilerOptions": {
    "target": "^3.5.0"
  },
  "ts-node": {
    "esm": true,
    "compilerOptions": {
      "moduleResolution": "node",
      "module": "commonjs",
      "verbatimModuleSyntax": false
    }
  }
}
