{
  "platform": {
    "php": "8.4"
  },
  "config": {
    "allow-plugins": {
      "cweagans/composer-patches": true
    }
  },
  "sort-packages": true,
  "require-dev": {
    "cweagans/composer-patches": "^1.7",
    "phing/phing": "*",
    "phpunit/phpunit": "^12.5.4"
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\CAFEVDB\\Tests\\": "../../tests/phpunit/",
      "OCA\\CAFEVDB\\": "../../lib/"
    }
  },
  "extra": {
    "patches": {
      "phing/phing": {
        "Make it work with junit log of recent PHPUnit releases": "../../composer-patches/phing/phing/fix-junit-log-dom-parsing.patch",
        "Do not use underscores in file-names, xslt does not like it": "../../composer-patches/phing/phing/replace-backslash-by-underscore-for-recent-xslt-compatibility.patch",
        "XSLT really does not like backslashes in file-names": "../../composer-patches/phing/phing/replace-backslash-by-slash-in-package-names.patch",
        "Fix PHP deprectations": "../../composer-patches/phing/phing/fix-php-deprectations.patch"
      }
    }
  }
}
