{
  "tags": {
    "allowUnknownTags": false
  },
  "source": {
    "include": "src",
    "includePattern": "(\\.js|\\.ts)$",
    "excludePattern": "(node_modules|src/toolkit/types/vue-shim.d.ts)"
  },
  "plugins": [
    "plugins/markdown",
    "node_modules/jsdoc-babel"
  ],
  "opts": {
    "template": "node_modules/docdash",
    "encoding": "utf8",
    "destination": "build/artifacts/doc/jsdoc",
    "recurse": true,
    "verbose": true
  },
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  },
  "babel": {
    "extensions": ["ts", "tsx"],
    "ignore": ["**/*.(test|spec).ts"],
    "babelrc": false,
    "presets": [["@babel/preset-env", { "targets": { "node": true } }], "@babel/preset-typescript"],
    "plugins": ["@babel/plugin-syntax-dynamic-import","@babel/proposal-class-properties", "@babel/plugin-transform-object-rest-spread"]
  }
}
