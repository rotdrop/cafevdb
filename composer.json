{
  "name": "rotdrop/cafevdb-nextcloud",
  "description": "Orchestra Management App",
  "type": "project",
  "license": "AGPL",
  "authors": [
    {
      "name": "Claus-Justus Heine"
    }
  ],
  "config": {
    "audit": {
      "block-insecure": false
    },
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true,
      "cweagans/composer-patches": true,
      "vildanbina/composer-upgrader": true
    }
  },
  "scripts": {
    "post-install-cmd": "bash -c 'rm -f vendor/jpgraph/jpgraph/lib/jpgraph/src/Examples/jpgraph'",
    "post-update-cmd": "bash -c 'rm -f vendor/jpgraph/jpgraph/lib/jpgraph/src/Examples/jpgraph'"
  },
  "require": {
    "behat/transliterator": "^1.3.0",
    "chillerlan/php-qrcode": "^4.2",
    "cmixin/business-day": "^1.12",
    "components/jquery": "^2.2.0",
    "components/jquery-migrate": "^3.0.0",
    "composer/spdx-licenses": "^1.5",
    "dompdf/dompdf": "^1.0",
    "ezyang/htmlpurifier": "^4.13.0",
    "giggsey/libphonenumber-for-php": "^9.0.0",
    "globalcitizen/php-iban": "^4.0",
    "guzzlehttp/guzzle": "7.9.3",
    "html2text/html2text": "^4.3",
    "jpgraph/jpgraph": "*",
    "kwn/number-to-words": "^2.8",
    "league/commonmark": "^2.6",
    "league/html-to-markdown": "^5.1",
    "malkusch/lock": "*",
    "markrogoyski/math-php": "2.*",
    "mathiasreker/php-svg-optimizer": "^5.2",
    "mpdf/mpdf": "^8.0",
    "paragonie/halite": "^5",
    "phpmailer/phpmailer": "^6.3.0",
    "phpoffice/phpspreadsheet": "^4.0.0",
    "setasign/fpdf": "*",
    "spatie/temporary-directory": "^1.3",
    "mll-lab/str_putcsv": "^1.2",
    "symfony/var-dumper": "*",
    "tecnickcom/tcpdf": "^6.3",
    "tinybutstrong/opentbs": "dev-production/cafevdb",
    "tuqqu/gender-detector": "^0.5.2",
    "guzzlehttp/promises": "2.2.0",
    "guzzlehttp/psr7": "2.7.1",
    "symfony/translation": "v6.4.30"
  },
  "provide": {
    "psr/log": "^3.0.0",
    "symfony/console": "^6.0.0"
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.8",
    "cweagans/composer-patches": "^1.7",
    "vildanbina/composer-upgrader": "^1.0"
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\CAFEVDB\\DevScripts\\PhpToTypeScript\\": "dev-scripts/php-to-typescript"
    }
  },
  "autoload": {
    "files": [
      "lib/Common/Functions.php"
    ]
  },
  "repositories": [
    {
      "type": "path",
      "url": "3rdparty/opentbs"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "bamarni-bin": {
      "bin-links": false,
      "target-directory": "vendor-bin",
      "forward-command": true
    },
    "patches": {
      "malkusch/lock": {
        "Allow a timeout of 0 in order to fail immediately when the lock is not available.": "composer-patches/malkusch/lock/loop-timeout-zero.patch"
      }
    }
  }
}
